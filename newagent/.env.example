# Groq API Key (Fast, high-throughput LLM inference)
# Get a free API key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Tavily API Key (Search engine optimized for LLMs & deep research)
# Get a free API key at https://app.tavily.com
TAVILY_API_KEY=tvly-your_tavily_api_key_here

# Optional: Preferred model on Groq (default: qwen/qwen3.8-27b or openai/gpt-oss-120b)
GROQ_MODEL=qwen/qwen3.8-27b

# Optional: Alternative LLM providers
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
