# ============================================================
# EventLens v1 — Environment Configuration
# Copy this file to .env and fill in your values.
# All configuration lives here; never edit source files to
# change settings.
# ============================================================

# ------------------------------------------------------------
# General
# ------------------------------------------------------------

# Port the web UI is published on (nginx).
WEB_PORT=8080

# Demo mode: auto | 1 | 0
#   auto  — live when all required keys are present, demo otherwise
#   1     — always demo (fixture replay, works offline)
#   0     — always live (errors if keys are missing)
DEMO_MODE=auto

# ------------------------------------------------------------
# FRED (Federal Reserve Economic Data)
# Get a free key at https://fred.stlouisfed.org/docs/api/api_key.html
# ------------------------------------------------------------
FRED_API_KEY=

# ------------------------------------------------------------
# SEC EDGAR
# Format: "AppName/Version contact@email.com"
# Required by SEC fair-use policy.
# ------------------------------------------------------------
SEC_USER_AGENT=EventLens/0.1 your@email.com

# ------------------------------------------------------------
# LLM — provider-neutral OpenAI-compatible endpoint
#
# Switching providers: change LLM_BASE_URL, LLM_API_KEY and
# LLM_MODEL, then run:  docker compose up -d
# No other files need to be changed.
# ------------------------------------------------------------

# --- Groq (default, free tier available) -------------------
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b

# reasoning-effort controls how many tokens the model spends
# reasoning before answering. "default" is a safe middle ground.
# LLM_EXTRA_BODY={"reasoning_effort":"default"}

# --- OpenAI (alternative) ----------------------------------
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=                   # check platform.openai.com/docs/models

# --- OpenRouter (alternative, 100+ models) -----------------
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-...
# LLM_MODEL=                   # check openrouter.ai/models

# --- Ollama (local, host must have Ollama running) ----------
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_API_KEY=ollama            # required but ignored by Ollama
# LLM_MODEL=                   # check ollama list

# Optional fallback model: used if the primary hits a daily 429.
# Example: LLM_FALLBACK_MODEL=openai/gpt-oss-20b
LLM_FALLBACK_MODEL=

# Optional JSON string merged verbatim into every LLM request body.
# Useful for provider-specific params (e.g. reasoning_effort on Groq).
# Must be valid JSON or leave empty.
LLM_EXTRA_BODY=

# Sampling / generation
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1200
# Max tokens sent TO the model (input). Keeps costs/latency predictable.
LLM_MAX_INPUT_TOKENS=4000
LLM_TIMEOUT_S=60
# Client-side requests-per-minute cap (prevents 429 on free tiers).
LLM_RPM_LIMIT=25

# ------------------------------------------------------------
# Baseline / comparison LLM (stretch toggle)
# Defaults to the same LLM_* values when not set.
# Override only if you want the plain-LLM comparison to use a
# different model or provider.
# ------------------------------------------------------------
# BASELINE_LLM_BASE_URL=
# BASELINE_LLM_API_KEY=
# BASELINE_LLM_MODEL=
